{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Bun runs the TypeScript sources directly (and `bun build --compile` bundles
    // them for the Docker image), so `build` is a type-check only (`tsc --noEmit`).
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "rootDir": "src",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}
