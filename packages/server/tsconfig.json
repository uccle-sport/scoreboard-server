{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    // Bun runs the TypeScript sources directly, so `build` is a type-check only
    // (`tsc --noEmit`). No declarations are emitted, which also avoids the
    // non-portable "type cannot be named" errors from Bun's isolated module layout.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}
