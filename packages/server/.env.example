# Server configuration. Copy to `.env` and fill in real values.
# `.env` is loaded automatically on startup (Bun loads `.env`, and see src/env.ts)
# for both `bun run --filter @scoreboard/server dev` and `... start`.

# --- Core ---
PORT=5000
GDS_SECRET=Secret
CORS_ORIGIN=*

# --- Flowr bearer ---
# Single token injected into every Flowr request: the device webhooks below, the
# channel-search requests, and the /channel-logo image proxy. Keep it out of the
# individual configs.
FLOWR_BEARER=

# --- Channel logo image proxy ---
# Logos are served by Flowr at a URL whose {logo} segment is the numeric view id
# derived from each channel's logo UUID. The server proxies these images via
# /channel-logo/<logo> so the bearer (which a browser <img> can't send) is applied.
FLOWR_LOGO_URL_TEMPLATE=https://sportlab.flowr.cloud/ozone/view/{logo}/org.taktik.filetype.original

# --- Per-display webhooks & channel sources ---
# These vars are keyed by scoreboard UUID with hyphens replaced by underscores.
# For UUID "abc-123" the suffix is "abc_123" -> e.g. POWER_ON_URL_abc_123.
# Replace <UUID> below with your scoreboard's sanitized UUID.
#
# Power on/off and display webhooks send a Flowr device message. Two placeholders
# are filled in the raw template before it is parsed as JSON:
#   {channel} — inside body.message.route, replaced with the selected channel id.
#   {volume}  — an unquoted numeric slot ("volume":{volume}), replaced with the
#               requested volume (0..100), or null when no volume is supplied.
# There is no separate volume webhook: a volume change re-sends the current
# display's TV_URL/SIGNAGE_URL with the selected channel and the new {volume}.
# The bearer is injected from FLOWR_BEARER — do not embed it here.

# POWER_ON_URL_<UUID>='{"url":"https://device-controller/api/send","method":"POST","body":{"devices":["DEVICE_UUID"],"message":{"type":"POWER_ON","route":"","volume":null,"lang":"en"},"shouldBeAcknowledged":true,"shouldWakeUpDevice":true}}'
# POWER_OFF_URL_<UUID>='{"url":"https://device-controller/api/send","method":"POST","body":{"devices":["DEVICE_UUID"],"message":{"type":"POWER_OFF","route":"","volume":null,"lang":"en"},"shouldBeAcknowledged":true,"shouldWakeUpDevice":true}}'
# SCOREBOARD_URL_<UUID>='{"url":"https://device-controller/api/send","method":"POST","body":{"devices":["DEVICE_UUID"],"message":{"type":"PLAY","route":"scoreboard","volume":null,"lang":"en"},"shouldBeAcknowledged":true,"shouldWakeUpDevice":true}}'
# TV_URL_<UUID>='{"url":"https://device-controller/api/send","method":"POST","body":{"devices":["DEVICE_UUID"],"message":{"type":"PLAY","route":"{channel}","volume":{volume},"lang":"en"},"shouldBeAcknowledged":true,"shouldWakeUpDevice":true}}'
# SIGNAGE_URL_<UUID>='{"url":"https://device-controller/api/send","method":"POST","body":{"devices":["DEVICE_UUID"],"message":{"type":"PLAY","route":"{channel}","volume":{volume},"lang":"en"},"shouldBeAcknowledged":true,"shouldWakeUpDevice":true}}'

# Channel lists feed the admin app's channel picker. The server POSTs this request
# to the Flowr channel-search API (bearer injected from FLOWR_BEARER) and maps
# results to {id,label,imageUrl?}.
# TV_CHANNELS_<UUID>='{"url":"https://sportlab.flowr.cloud/ozone/rest/v3/items/channel/search","method":"POST","channelType":"tv","body":{"query":{"$type":"BoolQuery","mustClauses":[{"$type":"TenantQuery","tenantId":"TENANT_ID","mode":"OWN_AND_PARENTS"},{"$type":"TermsQuery","field":"packages","values":["PACKAGE_ID"]}]},"offset":0,"sorts":[],"size":100}}'
# SIGNAGE_CHANNELS_<UUID>='{"url":"https://sportlab.flowr.cloud/ozone/rest/v3/items/channel/search","method":"POST","channelType":"signage","body":{"query":{"$type":"BoolQuery","mustClauses":[{"$type":"TenantQuery","tenantId":"TENANT_ID","mode":"OWN_AND_PARENTS"},{"$type":"TermsQuery","field":"packages","values":["PACKAGE_ID"]}]},"offset":0,"sorts":[],"size":100}}'

# --- Access control -------------------------------------------------------
# GDS_SECRET above authorises *observation only* — it travels in the URL, in
# browser history and in shared screenshots, so it cannot be a mutation
# credential. Changing the score or switching source additionally requires an
# 8-digit PIN. All values below must be digits and must not contain "$" (see
# src/env.ts for why).

# Recurring weekly windows in which the score may only be edited with the
# slot's own PIN, and no temporary control can be claimed. `days` accepts
# MON..SUN, inclusive ranges (MON-FRI), wrapping ranges (FRI-MON) and lists
# (SAT,SUN). Times are HH:MM in PROTECTED_SLOTS_TZ; "to" at or before "from"
# means the window spans midnight. Slot PINs are master keys: they work at any
# time and override whoever currently holds control, so rotate them each season.
# PROTECTED_SLOTS_<UUID>='[{"days":"MON-FRI","from":"18:00","to":"22:00","pin":"48127390"},{"days":"SAT,SUN","from":"09:00","to":"18:00","pin":"71905534"}]'
PROTECTED_SLOTS_TZ=Europe/Brussels

# PIN series unlocking TV / Signage switching. Every listed code is valid; a
# phone enters one once and stays unlocked for SOURCE_GRANT_TTL_MS. Accepts a
# JSON array or a bare comma-separated list. Leave unset and the source falls
# back to requiring score-edit control — it is never left open.
# TV_PINS_<UUID>='["11112222","22223333"]'
# SIGNAGE_PINS_<UUID>='["33334444"]'

# How long temporary control lasts from the moment it is claimed. Holders see a
# countdown and can extend it; when it lapses everyone is released together.
# May be overridden for one display with CONTROL_TTL_MS_<UUID>.
CONTROL_TTL_MS=5400000

# How long a phone stays unlocked for TV / Signage after entering a source PIN.
SOURCE_GRANT_TTL_MS=2592000000
